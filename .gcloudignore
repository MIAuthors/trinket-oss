# Rules from .gitignore apply
#!include:.gitignore

# ...but the per-deploy config overlay (gitignored) MUST reach the build image.
!config/local-production.yaml

# ...and the per-deploy brand logo (gitignored) MUST be baked into the image.
!public/img/brand/
!public/img/brand/**

# ...and the build stamp (gitignored, written by scripts/build-info.sh just
# before `gcloud builds submit`) MUST be baked in. Without this negation the
# `#!include:.gitignore` above drops it from the upload and GET /version reports
# "unknown" for commit/branch/builtAt on every Cloud Run deploy — verified live.
!build-info.json

# Not needed to build the image
test/
*.md
.nvmrc
.bowerrc
.agignore
Vagrantfile
deploy-cloudrun.sh
cleanup-cloudrun.sh
scripts/
SETUP.md
docker-compose.yml

# Per-deploy overlay folders ride along to Cloud Build (config/views/public),
# but never their .env (tooling-only secrets; the app gets env from Cloud Run).
!deploys/
!deploys/**
deploys/*/.env
